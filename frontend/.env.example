# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# FastAPI backend for LOCAL `next dev`.
# Only one NEXT_PUBLIC_API_URL is allowed here — duplicate keys do nothing useful
# (the last line wins). For Vercel, set NEXT_PUBLIC_API_URL in the Vercel project
# Environment Variables UI to your deployed API, e.g.:
#   https://digital-menu-smoky.vercel.app
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional override (defaults to ws:// from API URL):
# NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
# NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_DEFAULT_ORGANIZATION_ID=org_demo_001
    