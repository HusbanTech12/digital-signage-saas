# App
APP_NAME=Digital Signage SaaS API
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# Database — async SQLAlchemy (Supabase Postgres or local Docker)
# Use postgresql+asyncpg:// scheme
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/signage

# Optional: sync/direct URL for Alembic if pooler URL misbehaves
# DATABASE_URL_SYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/signage

# Clerk (https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Frontend API host from publishable key / Clerk dashboard, e.g. free-bream-89.clerk.accounts.dev
CLERK_FRONTEND_API=your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Redis (Prompt 8 pub/sub; Prompt 9 Celery Beat). Optional for single-worker
# local demo — API falls back to in-process WebSocket broadcast + inline scheduler.
REDIS_URL=redis://localhost:6379/0

# Prompt 9 — offline if no heartbeat within this window (kiosk beats every 15s)
SCREEN_OFFLINE_AFTER_SECONDS=60
# Run theme/offline ticks inside uvicorn (set false when using Celery Beat only)
INLINE_SCHEDULER=true
INLINE_SCHEDULER_INTERVAL_SECONDS=30

# Development: allow Authorization: Bearer dev:<clerk_user_id> (disable in prod)
DEV_AUTH_BYPASS=true

# Supabase (optional extras)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
